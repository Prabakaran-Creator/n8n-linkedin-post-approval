    {
      "parameters": {
        "promptType": "define",
        "text": "=You are ghostwriting a LinkedIn post for a senior welding inspector and senior quality specialist and QMS Lead Auditor in welding, NDT and painting/coating, with experience in marine, offshore, oil and gas and manufacturing.\n\nTopic: {{ $json.Topic }}\n\nRules:\n- Write in first person, in a confident, practical, field-experienced voice.\n- Line one must be a strong hook that a fabricator, QA/QC engineer or inspector would stop scrolling for.\n- 120-150 words, short paragraphs, plain language.\n- Use real inspection and quality thinking (defects, procedures, documentation, acceptance criteria, safety, cost of rework). Mention a standard or code only if it clearly applies to the topic. Never invent statistics, project names or client names.\n- End with one call to action, such as a question that invites other professionals to share their experience.\n- Maximum 3 relevant hashtags.\n- Return the post only, with no title or explanation.",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
